[Unit]
Description=Vérification discrète des mises à jour (démarrage + tous les 7 jours)
PartOf=graphical-session.target

[Timer]
# Only place where the delay before the first check after login is set:
# it leaves time for the network and the desktop session to be ready
OnStartupSec=1min
OnUnitActiveSec=7d

[Install]
WantedBy=timers.target
